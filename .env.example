# Provenance — local development environment
# Copy to .env.local (frontend) and .env (indexer) and fill in.
# .env / .env.local are .gitignored. Never commit a populated copy.

# ---------- Chain ----------
# RPC, REST, indexer URLs for the provenance-1 rollup.
NEXT_PUBLIC_PROVENANCE_RPC=https://rpc.provenance-1.initia.xyz
NEXT_PUBLIC_PROVENANCE_REST=https://rest.provenance-1.initia.xyz
NEXT_PUBLIC_PROVENANCE_INDEXER=https://indexer.provenance-1.initia.xyz

# Move package address — set after `aptos move publish` in Phase 2.
NEXT_PUBLIC_PROVENANCE_PACKAGE=

# OP bridge ID — set after rollup launches in Phase 1.
NEXT_PUBLIC_OP_BRIDGE_ID=

# ---------- R2 (image storage) ----------
R2_ENDPOINT=https://<account>.r2.cloudflarestorage.com
R2_BUCKET=provenance-art
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
NEXT_PUBLIC_R2_BASE=https://r2.provenance.app

# ---------- Indexer (apps/indexer/.env) ----------
DATABASE_URL=postgres://localhost:5432/provenance_dev
PROVENANCE_RPC=https://rpc.provenance-1.initia.xyz
PROVENANCE_PACKAGE_ADDRESS=

# ---------- Web → indexer proxy ----------
INDEXER_GRAPHQL_URL=http://localhost:42069/graphql

# ---------- Telemetry (production only) ----------
BETTER_STACK_INGEST_TOKEN=
DISCORD_WEBHOOK_URL=

# ---------- Vercel / GitHub Actions ----------
# Used only by .github/workflows/post-deploy-smoke.yml.
# Set in GitHub Actions secrets, not here.
# VERCEL_TOKEN=
# VERCEL_PROJECT_ID=
