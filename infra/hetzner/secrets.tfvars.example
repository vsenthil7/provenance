# Copy to secrets.tfvars and fill in. NEVER commit secrets.tfvars.
# Hackathon-minimal variant requires only two values.

hcloud_token   = "REPLACE-with-Hetzner-Cloud-API-token-Read-and-Write"

# Paste the FULL contents of your SSH public key file here (e.g. ~/.ssh/id_ed25519.pub).
# Looks like: "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAI... your_email@example.com"
ssh_public_key = "REPLACE-with-ssh-public-key-line"
